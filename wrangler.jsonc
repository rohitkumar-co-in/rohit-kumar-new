{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rohitkumar-portfolio",
  "account_id": "44b16a06f6e343d14954bd86a7603e25",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/work", "/work/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "secrets": {
    "required": ["BOT_TOKEN", "USER_ID", "TURNSTILE_SECRET_KEY"]
  }
}
