---
interface Props { name: 'arrow' | 'spark' | 'menu' | 'close' | 'external' | 'check' | 'code' }
const { name } = Astro.props;
---
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {name === 'arrow' && <><path d="M4.5 12h14M12 5.5l6.5 6.5-6.5 6.5" /></>}
  {name === 'external' && <><path d="M13 5h6v6M19 5l-9 9" /><path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></>}
  {name === 'spark' && <><path d="M12 2.7 14.4 9.6 21.3 12l-6.9 2.4-2.4 6.9-2.4-6.9L2.7 12l6.9-2.4L12 2.7Z" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18" /></>}
  {name === 'check' && <><path d="m5 12 4.3 4.3L19 6.8" /></>}
  {name === 'code' && <><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" /></>}
</svg>
