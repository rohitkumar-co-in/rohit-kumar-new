---
import { brandDescriptor, email, navItems, socials } from '../data/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand-block">
      <a href="/" class="wordmark footer-mark"><BrandMark /><span class="wordmark-copy">Rohit Kumar<small>{brandDescriptor}</small></span></a>
      <p>I build websites that bring in more leads, custom software and SaaS that make work easier, and automations that save your team time.</p>
    </div>
    <div class="footer-nav-group">
      <span class="footer-label">Explore</span>
      <nav class="footer-links" aria-label="Footer navigation">{navItems.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </div>
    <div class="footer-connect">
      <span class="footer-label">Get in touch</span>
      <a class="footer-project-link" href="/contact/">Let’s talk <Icon name="arrow" /></a>
      <a class="footer-email" href={`mailto:${email}`}>{email}<span>↗</span></a>
      <div class="footer-socials" aria-label="Social links">{socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}</div>
    </div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Rohit Kumar</span><nav class="footer-legal" aria-label="Legal information"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookies/">Cookies</a></nav><span class="footer-descriptor">{brandDescriptor}</span></div>
</footer>
