---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { email, projects, services } from '../data/site';
const tickerItems = ['Custom software', 'Business-first thinking', 'AI-powered workflows'];
---
<BaseLayout title="Rohit Kumar | Business Software & Websites" description="I build websites, software, APIs, and custom automations that solve real business problems and help companies capture more leads.">
  <section class="home-hero page-shell">
    <div class="hero-copy">
      <div class="hero-overline" data-reveal><span class="availability-dot"></span><span>I’m a 22-year-old builder · Founder of Leadomi</span><span class="hero-location">India · <b data-local-time>--:--</b></span></div>
      <h1 class="hero-title" data-reveal>Give me a problem.<br /><span>I’ll build a solution.</span></h1>
      <p class="hero-lede" data-reveal>I build websites, software, and APIs that move businesses forward, using AI and modern tools where they make a real difference.</p>
      <div class="hero-actions" data-reveal><a class="button button-primary" href="/work/">Explore selected work <Icon name="arrow" /></a></div>
      <div class="hero-proof" data-reveal><span>3 years building products for real businesses</span></div>
    </div>
    <div class="hero-portrait" data-reveal>
      <div class="portrait-frame">
        <svg class="hero-illustration" viewBox="0 0 720 660" role="img" aria-labelledby="hero-visual-title hero-visual-desc">
          <title id="hero-visual-title">How I solve business problems with software and AI</title><desc id="hero-visual-desc">A portrait of me among interface windows, code, workflow automation and a product growth signal.</desc>
          <defs>
            <radialGradient id="haloGradient"><stop offset="0" stop-color="#B9A2FF" stop-opacity=".56"/><stop offset=".65" stop-color="#CFC0FF" stop-opacity=".22"/><stop offset="1" stop-color="#F8F6FB" stop-opacity="0"/></radialGradient>
            <linearGradient id="founderPortraitFade" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="white"/><stop offset="68%" stop-color="white"/><stop offset="100%" stop-color="black"/></linearGradient>
            <mask id="founderPortraitMask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox" x="0" y="0" width="1" height="1"><rect width="1" height="1" fill="url(#founderPortraitFade)"/></mask>
            <linearGradient id="windowGradient" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#fff" stop-opacity=".94"/><stop offset="1" stop-color="#F3EEFF" stop-opacity=".78"/></linearGradient>
            <linearGradient id="lineGradient"><stop stop-color="#8057F5"/><stop offset="1" stop-color="#C4AFFF"/></linearGradient>
            <filter id="softShadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="14" stdDeviation="16" flood-color="#4A22B8" flood-opacity=".17"/></filter>
          </defs>
          <ellipse cx="360" cy="340" rx="320" ry="282" fill="url(#haloGradient)"/>
          <ellipse class="illustration-orbit orbit-slow" cx="360" cy="328" rx="254" ry="189" transform="rotate(-22 360 328)" fill="none" stroke="#A98BFF" stroke-opacity=".43" stroke-width="1.5" stroke-dasharray="3 8"/>
          <path class="illustration-path" d="M83 383c65-119 150-139 238-65 77 64 125 38 179-77 34-71 73-93 134-74" fill="none" stroke="url(#lineGradient)" stroke-width="2" stroke-dasharray="4 7"/>
          <g class="illustration-window float-window-left" filter="url(#softShadow)" transform="rotate(-8 152 228)">
            <rect x="43" y="168" width="199" height="128" rx="18" fill="url(#windowGradient)" stroke="#fff" stroke-width="2"/>
            <rect x="43" y="168" width="199" height="28" rx="18" fill="#ECE4FF"/><path d="M43 184v12h199v-12" fill="#ECE4FF"/>
            <circle cx="61" cy="182" r="3" fill="#9F7BFF"/><circle cx="73" cy="182" r="3" fill="#C0ACFF"/><circle cx="85" cy="182" r="3" fill="#E0D6FF"/>
            <rect x="59" y="211" width="71" height="69" rx="10" fill="#E4DAFF"/><path d="M71 260c9-20 14-33 26-31 9 2 13 18 21 19" fill="none" stroke="#8057F5" stroke-width="3" stroke-linecap="round"/><circle cx="108" cy="232" r="5" fill="#B9A2FF"/>
            <rect x="143" y="213" width="80" height="8" rx="4" fill="#9D82F0"/><rect x="143" y="231" width="62" height="6" rx="3" fill="#D0C2FA"/><rect x="143" y="246" width="72" height="6" rx="3" fill="#D0C2FA"/><rect x="143" y="264" width="37" height="12" rx="6" fill="#7040E8"/>
          </g>
          <g class="illustration-window float-window-right" filter="url(#softShadow)" transform="rotate(8 568 240)">
            <rect x="472" y="190" width="193" height="112" rx="17" fill="#26155A" stroke="#fff" stroke-opacity=".8" stroke-width="2"/>
            <circle cx="490" cy="207" r="3" fill="#C9B5FF"/><circle cx="502" cy="207" r="3" fill="#8A65F5"/><circle cx="514" cy="207" r="3" fill="#6944D9"/>
            <text x="490" y="234" fill="#AB91FF" font-family="monospace" font-size="11">&lt;solve&gt;</text><text x="490" y="252" fill="#F0EAFE" font-family="monospace" font-size="10">const problem = yours;</text><text x="490" y="272" fill="#C8B7FF" font-family="monospace" font-size="10">build(solution);</text><path d="M622 230h17M624 248h15M630 268h9" stroke="#7C5ADA" stroke-width="3" stroke-linecap="round" opacity=".7"/>
          </g>
          <g class="illustration-window float-window-bottom" filter="url(#softShadow)" transform="rotate(4 538 448)">
            <rect x="456" y="389" width="164" height="94" rx="17" fill="url(#windowGradient)" stroke="#fff" stroke-width="2"/>
            <text x="475" y="413" fill="#6A6084" font-family="monospace" font-size="9">AI-POWERED WORKFLOW</text><text x="475" y="448" fill="#1D1533" font-family="sans-serif" font-size="20" font-weight="700">Idea → impact</text>
            <path d="m478 469 20 0 18-16 18 0 20-18 22 0 20-18" fill="none" stroke="#6C3CF0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M478 469h118" stroke="#D8CCFA" stroke-width="1"/>
          </g>
          <g class="illustration-badge badge-code" transform="translate(291 83)"><circle r="30" fill="#fff" stroke="#E7DEFF" stroke-width="1.5"/><path d="m-7-8-8 8 8 8m14-16 8 8-8 8m-1-22-6 28" fill="none" stroke="#6C3CF0" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></g>
          <g class="illustration-badge badge-spark" transform="translate(633 362)"><circle r="25" fill="#fff" stroke="#E7DEFF" stroke-width="1.5"/><path d="m0-12 3.5 8.5L12 0 3.5 3.5 0 12-3.5 3.5-12 0l8.5-3.5z" fill="#8057F5"/></g>
          <circle cx="110" cy="399" r="7" fill="#8B68F5"/><circle cx="610" cy="115" r="6" fill="#B9A2FF"/><circle cx="412" cy="529" r="5" fill="#9B7AFF"/>
          <image href="/images/rohit.webp" x="184" y="174" width="352" height="386" preserveAspectRatio="xMidYMax meet" mask="url(#founderPortraitMask)" />
        </svg>
        <div class="portrait-caption"><span>RK / 22</span><span>Learn fast. Build boldly. ↘</span></div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="How I build"><div class="ticker-track"><div class="ticker-group">{Array.from({ length: 3 }).flatMap(() => tickerItems).map((item) => <span class="ticker-item"><span>{item}</span><b>✳</b></span>)}</div><div class="ticker-group" aria-hidden="true">{Array.from({ length: 3 }).flatMap(() => tickerItems).map((item) => <span class="ticker-item"><span>{item}</span><b>✳</b></span>)}</div></div></div>

  {projects.map((project, index) => <section class="project-highlight page-shell" aria-label={`${project.name} featured project`}>
    <div class="section-heading" data-reveal><div><p class="section-kicker"><span>{String(index + 1).padStart(2, '0')}</span> {index === 0 ? 'Selected work' : 'More selected work'}</p><h2>{index === 0 ? <>Things I built.<br /><em>Problems they solve.</em></> : <>{project.name}.<br /><em>Built for a real need.</em></>}</h2></div>{index === 0 && <a class="section-link" href="/work/">All projects <Icon name="arrow" /></a>}</div>
    <div class="project-feature-card" data-reveal><ProjectCard project={project} /></div>
  </section>)}

  <section class="services-preview page-shell" aria-labelledby="services-title">
    <div class="services-intro" data-reveal><p class="section-kicker"><span>03</span> Business-focused solutions</p><h2 id="services-title">Find the problem.<br /><em>Build the right fix.</em></h2><p>I build websites, software, APIs, and custom automations for repetitive tasks, based on what your business needs.</p><a class="button button-outline" href="/services/">Explore solutions <Icon name="arrow" /></a></div>
    <div class="service-list">{services.map((service) => <a class="service-row" href="/services/" data-reveal><span class="service-index">{service.index}</span><span class="service-copy"><strong>{service.title}</strong><small>{service.text}</small></span><span class="service-mark">{service.mark}</span></a>)}</div>
  </section>

  <section class="offer-band page-shell" data-reveal aria-label="Custom development pricing"><div class="offer-motif" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div><div class="offer-copy"><p class="section-kicker"><span>04</span> Custom builds start here</p><h2>Custom development<br />from <em>$599</em></h2><p>The final price depends on what you need and how complex it is. I’ll scope the work with you before sending a quote.</p><a class="button button-light" href="/contact/">Tell me what you’re building <Icon name="arrow" /></a></div><span class="offer-side-note">ONE PROJECT<br />BUILT AROUND YOU</span></section>

  <section class="home-about page-shell"><div class="about-card" data-reveal><div class="about-copy"><p class="section-kicker"><span>05</span> A little about me</p><h2>Curious.<br /><em>Always building.</em></h2><p>I'm a young founder, business owner and hands-on builder. Over three years of product work and freelancing, I've learned to use software, AI and modern tools to solve real business problems.</p><a class="text-link" href="/about/">More about me <span>↗</span></a></div><span class="about-index">RK—05</span></div></section>

  <section class="closing-cta page-shell" data-reveal><p class="section-kicker"><span>06</span> Your problem, my next build</p><h2>What do you need<br /><em>to make happen?</em></h2><div class="closing-bottom"><p>Give me the context. I’ll help figure out what to build and how to get it moving.</p><a href={`mailto:${email}`} class="closing-arrow" aria-label="Email Rohit Kumar"><Icon name="arrow" /></a></div><div class="closing-spark" aria-hidden="true"><Icon name="spark" /></div></section>
</BaseLayout>
