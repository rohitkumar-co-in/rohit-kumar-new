---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Software Projects & Case Studies | Rohit Kumar" description="Explore products and confidential internal tools built to solve real problems in lead follow-up, verification, temporary email, and business calling.">
  <section class="inner-hero page-shell projects-hero"><p class="section-kicker" data-reveal>Selected projects / 2023—26</p><div class="inner-hero-line"><h1 data-reveal>Things I’ve built.<br /><em>Problems they solve.</em></h1><p data-reveal>From missed-call follow-up and SMS verification to confidential internal tools for temporary email and SIP calling, each project starts with a real workflow to improve.</p></div><div class="projects-count" data-reveal><span>{String(projects.length).padStart(2, '0')}</span> projects built <i></i> Take a look</div><nav class="project-jump" aria-label="Jump to a project" data-reveal>{projects.map((project) => <a href={`#project-${project.slug}`}><span>{project.number}</span>{project.name}<Icon name="arrow" /></a>)}</nav></section>
  {projects.map((project) => <section id={`project-${project.slug}`} class="project-index page-shell" aria-label={`${project.name} project`}><div class="project-index-row" data-reveal><div class="project-card-wrap"><ProjectCard project={project} /></div></div></section>)}
  <ClosingCTA number="03" />
</BaseLayout>
