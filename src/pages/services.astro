---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { projectPricingNote, services } from '../data/site';
---
<BaseLayout title="Web Development & Automation | Rohit Kumar" description="Websites that bring in more leads, software that saves your team time, and automations that handle repeat tasks. Projects start at $599.">
  <section class="inner-hero service-hero page-shell"><p class="section-kicker" data-reveal>Solutions / What I build</p><div class="inner-hero-line"><h1 data-reveal>What’s getting in the way?<br /><em>Let’s fix it.</em></h1><p data-reveal>I build websites, software, APIs, and automations to help you get more leads, save time, and solve the problems slowing your business down.</p></div><div class="service-artwork" data-reveal aria-hidden="true"><div class="service-art-glow"></div><div class="service-art-core"><span>PROBLEM</span><i>✳</i><span>BUILT WITH</span><b>PURPOSE</b></div><div class="service-art-ring ring-a"></div><div class="service-art-ring ring-b"></div><div class="service-art-tag tag-a">AI + MODERN TOOLS</div><div class="service-art-tag tag-b">BUILT AROUND YOUR BUSINESS</div></div></section>
  <section class="services-detail page-shell"><div class="service-detail-intro" data-reveal><p class="section-kicker"><span>01</span> What I can build</p><h2>Tools that fit<br /><em>the way you work.</em></h2><p>Maybe you need a website that brings in more leads, software that makes a hard task easier, or automation that saves hours. Tell me what’s not working, and I’ll help find a good way to fix it.</p></div><div class="service-detail-list">{services.map((service) => <article class="service-detail-row" data-reveal><span>{service.index}</span><div><h3>{service.title}</h3><p>{service.text}</p></div><b>{service.mark}</b></article>)}</div></section>
  <section class="process-section page-shell"><div class="section-heading" data-reveal><div><p class="section-kicker"><span>02</span> The process</p><h2>From first conversation<br /><em>to launch.</em></h2></div><p class="process-note">First, we agree on the problem and what a better result looks like. Then I plan the build and keep you updated along the way.</p></div><ol class="process-list"><li data-reveal><span>01</span><div><h3>Find what’s not working</h3><p>We look for missed leads, slow tasks, or anything getting in the way of growth.</p></div><b>↘</b></li><li data-reveal><span>02</span><div><h3>Agree on the goal</h3><p>We get clear on what needs to improve, the budget, and the timeline.</p></div><b>↘</b></li><li data-reveal><span>03</span><div><h3>Build and test</h3><p>I share progress and make changes based on your feedback.</p></div><b>↘</b></li><li data-reveal><span>04</span><div><h3>Get it ready to launch</h3><p>I prepare the build for your team and customers, then help plan what comes next.</p></div><b>↗</b></li></ol></section>
  <section class="pricing-feature page-shell"><div class="pricing-aside" data-reveal><p class="section-kicker"><span>03</span> Pricing</p><p>One project.<br />One clear plan.</p></div><div class="pricing-main" data-reveal><span class="pricing-label">CUSTOM DEVELOPMENT</span><p class="price-display"><sup>FROM</sup><strong>$599</strong><span>USD</span></p><p>{projectPricingNote}</p><ul><li><Icon name="check" /> A build made for your goal</li><li><Icon name="check" /> Custom design and development</li><li><Icon name="check" /> Ready to launch</li></ul><a class="button button-primary" href="/contact/">Tell me what you need <Icon name="arrow" /></a></div><div class="pricing-stamp" aria-hidden="true">NO<br />ONE-SIZE<br />TEMPLATE</div></section>
  <ClosingCTA number="04" />
</BaseLayout>
