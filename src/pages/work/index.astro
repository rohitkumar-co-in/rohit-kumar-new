---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Projects & Case Studies | Rohit Kumar" description="Explore Leadomi and OTP Wala, two products I built to address lead capture and phone verification needs.">
  <section class="inner-hero page-shell work-hero"><p class="section-kicker" data-reveal>Selected work / 2023—26</p><div class="inner-hero-line"><h1 data-reveal>Products I’ve built.<br /><em>Made to solve real needs.</em></h1><p data-reveal>Leadomi and OTP Wala started with practical business needs. Here’s what I built to address them.</p></div><div class="work-count" data-reveal><span>02</span> projects built <i></i> Explore a project</div><nav class="work-jump" aria-label="Jump to a project" data-reveal>{projects.map((project) => <a href={`#project-${project.slug}`}><span>/{project.number}</span>{project.name}<Icon name="arrow" /></a>)}</nav></section>
  {projects.map((project) => <section id={`project-${project.slug}`} class="work-index page-shell" aria-label={`${project.name} project`}><div class="work-index-row" data-reveal><span class="work-row-no">/{project.number}</span><div class="work-card-wrap"><ProjectCard project={project} /></div><div class="work-side-caption"><span>{project.role}</span><span>{project.focus.join(' · ')}</span><a href={`/work/${project.slug}/`}>Open case study <Icon name="arrow" /></a></div></div></section>)}
  <ClosingCTA number="03" />
</BaseLayout>
