---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const isLeadomi = project.slug === 'leadomi';
---
<BaseLayout title={`${project.name} Case Study | Rohit Kumar`} description={project.summary}>
  <section class={`case-hero page-shell case-${project.color}`}>
    <a href="/work/" class="back-link" data-reveal><Icon name="arrow" /> All projects</a>
    <div class="case-heading" data-reveal><p class="section-kicker"><span>{project.number}</span> Product / {project.kind}</p><h1>{project.name}<br /><em>{isLeadomi ? 'Turn interest into action.' : 'Make verification easier.'}</em></h1><p>{project.summary}</p><a class="button button-primary" href={project.url} target="_blank" rel="noreferrer">Visit {project.name} <Icon name="external" /></a></div>
    <figure class="case-visual" data-reveal><img class="case-screenshot" src={project.screenshot} alt={`${project.name} homepage`} loading="eager" /></figure>
  </section>
  <section class="case-details page-shell"><div class="case-story" data-reveal><p class="section-kicker"><span>01</span> The problem behind it</p><h2>{isLeadomi ? 'Give teams a clearer way to handle new leads.' : 'Make user verification easier to add.'}</h2><p>{isLeadomi ? 'I started Leadomi to give businesses a more direct way to capture leads and follow up. I wanted to build a product around the work that happens after a potential customer shows interest.' : 'I built OTP Wala around a straightforward need: help products verify phone numbers without making developers wrestle with the integration. The product connects the API side with a direct verification flow.'}</p><p>{isLeadomi ? 'As founder, I work on the product and its software. I keep learning what businesses need, then use modern tools to turn those needs into product decisions and working features.' : 'I worked across the product and API, thinking through what a developer needs to connect the service and what a user sees during verification.'}</p></div><aside class="case-facts" data-reveal><div><span>MY ROLE</span><strong>{project.role}</strong></div><div><span>THE FOCUS</span><strong>{project.focus.join(' / ')}</strong></div><div><span>LIVE PRODUCT</span><a href={project.url} target="_blank" rel="noreferrer">{project.url.replace('https://', '')} ↗</a></div><div><span>BUILT WITH</span><strong>Product thinking, software and modern tools</strong></div></aside></section>
  <section class="case-next page-shell" data-reveal><span>HAVE A PROBLEM LIKE THIS?</span><a href="/contact/">Tell me about it <Icon name="arrow" /></a></section>
</BaseLayout>
