---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const isLeadomi = project.slug === 'leadomi';
---
<BaseLayout title={`${project.name} Case Study | Rohit Kumar`} description={project.summary}>
  <section class={`case-hero page-shell case-${project.color}`}>
    <a href="/work/" class="back-link" data-reveal><Icon name="arrow" /> All projects</a>
    <div class="case-heading" data-reveal><p class="section-kicker"><span>{project.number}</span> My product / {project.kind}</p><h1>{project.name}<br /><em>{isLeadomi ? 'I built it to capture leads.' : 'I built it to simplify verification.'}</em></h1><p>{project.summary}</p><a class="button button-primary" href={project.url} target="_blank" rel="noreferrer">Visit {project.name} <Icon name="external" /></a></div>
    <figure class="case-visual" data-reveal><img class="case-screenshot" src={project.screenshot} alt={`${project.name} homepage`} loading="eager" /></figure>
  </section>
  <section class="case-details page-shell"><div class="case-story" data-reveal><p class="section-kicker"><span>01</span> Why I built it</p><h2>{isLeadomi ? 'Give teams a clearer way to handle new leads.' : 'Make phone verification easier to add.'}</h2><p>{isLeadomi ? 'I started Leadomi to give businesses a more direct way to capture leads and follow up. I built it around the work that begins after a potential customer shows interest.' : 'I built OTP Wala to help product teams verify phone numbers without a complicated integration. I focused on keeping the API and user verification flow straightforward.'}</p><p>{isLeadomi ? 'I lead the product and its software, learning what businesses need and turning those needs into practical product decisions and features.' : 'I worked across the product and API, focusing on what developers need to connect the service and what users need to complete verification.'}</p></div><aside class="case-facts" data-reveal><div><span>MY ROLE</span><strong>{project.role}</strong></div><div><span>THE FOCUS</span><strong>{project.focus.join(' / ')}</strong></div><div><span>LIVE PRODUCT</span><a href={project.url} target="_blank" rel="noreferrer">{project.url.replace('https://', '')} ↗</a></div><div><span>BUILT WITH</span><strong>Product thinking, software and modern tools</strong></div></aside></section>
  <ClosingCTA number="02" />
</BaseLayout>
