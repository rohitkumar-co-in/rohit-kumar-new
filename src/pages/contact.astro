---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { email, projectPricingNote, socials } from '../data/site';
---
<BaseLayout title="Start a Project | Rohit Kumar" description="Tell me what you want to improve. I build websites, software, and automations to bring in more leads and save your team time. Projects start at $599.">
  <section class="contact-hero page-shell"><div class="contact-intro"><p class="section-kicker" data-reveal>Contact / New project</p><h1 data-reveal>What do you want<br /><em>to improve?</em></h1><p data-reveal>Tell me what’s costing you leads, taking too much time, or getting in the way of a new idea.</p><a class="contact-direct" href={`mailto:${email}`} data-reveal><span>Prefer email?</span><strong>{email} ↗</strong></a><div class="contact-social" data-reveal><span>FIND ME ELSEWHERE</span>{socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label} ↗</a>)}</div><div class="contact-deco" aria-hidden="true"><span>LET’S</span><b>SOLVE IT</b><i>✳</i></div></div>
  <form class="contact-form" data-contact-form data-turnstile-enabled="false" data-reveal method="POST" action="/api/contact">
    <label class="form-honey" aria-hidden="true">Leave this field empty<input name="_honey" tabindex="-1" autocomplete="off" /></label>
    <div class="form-heading"><span>PROJECT ENQUIRY</span><span>01 — 05</span></div>
    <label class="form-field"><span>Your name <i>*</i></span><input name="name" type="text" autocomplete="name" placeholder="What should I call you?" required minlength="2" /></label>
    <label class="form-field"><span>Email address <i>*</i></span><input name="email" type="email" autocomplete="email" placeholder="you@company.com" required /></label>
    <div class="form-split"><label class="form-field"><span>What do you need?</span><select name="projectType"><option value="">Pick one</option><option>Website to bring in more leads</option><option>Business software / product</option><option>API / integration</option><option>Automation to save time</option><option>Something else</option></select></label><label class="form-field"><span>Budget range</span><select name="budget"><option value="">Not sure yet</option><option>$599–$1,500</option><option>$1,500–$5,000</option><option>$5,000+</option><option>Let’s discuss</option></select></label></div>
    <label class="form-field"><span>What are you trying to fix? <i>*</i></span><textarea name="message" rows="5" placeholder="What’s taking too much time or costing you leads?" required minlength="15"></textarea></label>
    <div data-turnstile-mount></div>
    <p class="form-status" data-turnstile-status role="status" aria-live="polite">Loading the security check…</p>
    <p class="turnstile-setup-note" data-turnstile-fallback hidden>The form is unavailable right now. <a href={`mailto:${email}`}>Email me directly</a>.</p>
    <div class="form-submit-row"><p>{projectPricingNote}</p><button type="submit" class="button button-primary" disabled>Send project details <Icon name="arrow" /></button></div>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    <p class="form-note">Prefer email? <a href={`mailto:${email}`}>Reach me directly</a>.</p>
  </form></section>
  <section class="contact-strip page-shell"><span>NO PROJECT IS ONE-SIZE-FITS-ALL</span><i></i><span>LET’S START WITH THE PROBLEM</span></section>
  <script is:inline>
    (() => {
      const form = document.querySelector('[data-contact-form]');
      const button = form?.querySelector('button[type="submit"]');
      const mount = document.querySelector('[data-turnstile-mount]');
      const status = document.querySelector('[data-turnstile-status]');
      const fallback = document.querySelector('[data-turnstile-fallback]');
      if (!form || !button || !mount || !status || !fallback) return;

      const setUnavailable = (message = 'The security check could not load. Please email me directly instead.') => {
        button.disabled = true;
        status.dataset.state = 'error';
        status.textContent = message;
        fallback.hidden = false;
      };

      window.onContactTurnstileSuccess = () => {
        button.disabled = false;
        form.dataset.turnstileEnabled = 'true';
        status.dataset.state = 'success';
        status.textContent = 'Security check complete.';
      };
      window.onContactTurnstileExpired = () => {
        button.disabled = true;
        status.dataset.state = 'error';
        status.textContent = 'The security check expired. Please complete it again.';
      };
      window.onContactTurnstileError = (errorCode) => {
        setUnavailable(String(errorCode) === '110200'
          ? 'This address is not allowed by the security check. Please email me directly instead.'
          : 'The security check could not load. Please email me directly instead.');
        return true;
      };

      fetch('/api/turnstile-config', { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then(async (response) => {
          if (!response.ok) throw new Error('Turnstile settings could not be loaded.');
          const config = await response.json();
          if (typeof config.siteKey !== 'string' || !config.siteKey.trim()) throw new Error('Turnstile site key is missing.');
          return config.siteKey.trim();
        })
        .then((siteKey) => {
          const widget = document.createElement('div');
          widget.className = 'cf-turnstile';
          widget.dataset.sitekey = siteKey;
          widget.dataset.action = 'contact';
          widget.dataset.callback = 'onContactTurnstileSuccess';
          widget.dataset.errorCallback = 'onContactTurnstileError';
          widget.dataset.expiredCallback = 'onContactTurnstileExpired';
          widget.dataset.timeoutCallback = 'onContactTurnstileExpired';
          mount.append(widget);
          status.textContent = 'Complete the security check to enable sending.';

          const script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          script.async = true;
          script.defer = true;
          script.onerror = () => window.onContactTurnstileError();
          document.head.append(script);
        })
        .catch(() => setUnavailable());
    })();
  </script>
</BaseLayout>
