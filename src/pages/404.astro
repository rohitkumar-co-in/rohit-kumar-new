---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page Not Found | Rohit Kumar" description="This page isn’t here. Head back to Rohit Kumar’s portfolio to explore projects, services, and contact details." noindex>
  <section class="not-found page-shell" aria-labelledby="not-found-title">
    <p class="section-kicker"><span>404</span> Page not found</p>
    <h1 id="not-found-title">This page<br /><em>doesn’t exist.</em></h1>
    <p>The link may be old, or the address may have a typo. Head back and find what you need.</p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">Go to homepage <Icon name="arrow" /></a>
      <a class="text-link" href="/projects/">Explore projects <span>↗</span></a>
    </div>
    <span class="not-found-mark" aria-hidden="true">404</span>
  </section>
</BaseLayout>
